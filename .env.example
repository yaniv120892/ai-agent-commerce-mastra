# OpenAI API key used by the Mastra agent.
OPENAI_API_KEY=sk-your-key-here

# Only gpt-5.4-mini and gpt-5.4-nano are permitted for this assignment.
# gpt-4o-mini is NOT permitted, despite appearing in the original design doc.
OPENAI_MODEL=gpt-5.4-mini

# Disables Mastra's outbound telemetry (posthog-node).
MASTRA_TELEMETRY_DISABLED=1
