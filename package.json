  },
  "dependencies": {
    "@ai-sdk/openai": "4.0.16",
    "@ai-sdk/react": "4.0.34",
    "@base-ui/react": "^1.6.0",
    "@mastra/ai-sdk": "1.6.2",
    "@mastra/core": "1.51.0",
    "@mastra/libsql": "1.16.0",
    "@mastra/memory": "1.23.0",
    "ai": "7.0.31",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.25.0",
    "next": "16.2.10",
    "react": "19.2.4",
    "react-dom": "19.2.4",
